// CalorieKnight's rules (cloud saves and the World Boss), for The Calorie Card's Firebase project (auth-af04a).
// Merge this `match` block into the project's existing rules (Firebase console → Firestore →
// Rules); don't replace the rules The Calorie Card already relies on.
//
// Early-stage rules: any signed-in hero can read the fight and update it (the app does the
// maths in a transaction). Before a wide launch, move the strike into a Cloud Function so the
// client can't write arbitrary numbers.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each hero's save: only its own account can read or write it.
    match /ck_saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Each hero's recent foods and recipes, likewise private.
    match /ck_foodbook/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /ck_worldBoss/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && doc == 'current'
        && request.resource.data.keys().hasAll(['gen', 'boss', 'hp', 'maxHp', 'hits', 'seen']);
    }
  }
}
